# Backend: copy to .env and export these values before starting Flask.
# No credentials in this file are real. The backend reads environment variables.
NODE_ENV=development
PORT=5000
# PostgreSQL in production; leave blank for SQLite during local development.
DATABASE_URL=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# SECRET_KEY is a supported legacy alias. Preserve the old value when upgrading.
SECRET_KEY=
# Optional separate secrets; default to SESSION_SECRET when blank/unset.
OTP_SECRET=
CHAT_KEY_SECRET=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
# Production: None for cross-site, Lax for same-site sibling custom domains.
SESSION_COOKIE_SAMESITE=Lax
# Development only. Production rejects SQLite and local upload storage.
LOCAL_DATABASE_PATH=

# SMTP for local development. For free Render, use brevo (HTTPS).
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
# Verify this sender email address in Brevo before sending.
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ponhakvontey123@gmail.com
SMTP_PASSWORD=
SMTP_FROM=ponhakvontey123@gmail.com
SMTP_STARTTLS=true
SMTP_SSL=false

# Required in production; create a PRIVATE bucket named uploads (or override).
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=uploads

# Frontend only: set at Render build time; this URL is public, not a secret.
# Leave empty during local dev to use Vite's proxy.
VITE_API_BASE_URL=
